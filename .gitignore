# ─────────────────────────────────────────────
# Sparkiddo — .gitignore
# Keeps secrets and junk out of the repository
# ─────────────────────────────────────────────

# ── SECRETS & CREDENTIALS ────────────────────
.env
.env.local
.env.development
.env.production
.env.staging
*.key
*.pem
*.p12
*.p8
secrets.json
config.local.js

# ── NODE / REACT NATIVE ───────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
package-lock.json

# ── EXPO / EAS ────────────────────────────────
.expo/
dist/
web-build/
*.orig.*
*.jks
*.keystore
!debug.keystore
google-services.json
GoogleService-Info.plist
eas.json

# ── BUILD OUTPUTS ─────────────────────────────
build/
*.apk
*.aab
*.ipa
*.xcarchive

# ── OS FILES ──────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── EDITOR / IDE ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── LOGS & TEMP ───────────────────────────────
*.log
*.tmp
*.temp
.cache/
coverage/
.nyc_output/

# ── SUPABASE LOCAL ────────────────────────────
.supabase/
supabase/.temp/

# ── TESTING ───────────────────────────────────
__tests__/results/
jest.config.local.js
